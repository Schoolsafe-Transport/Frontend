# ==========================================
# SchoolSafe Web Frontend Environment Template
# ==========================================

# Backend REST API Base URL (must include /api)
# Local Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api or https://yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Backend Real-Time Socket.IO Server URL (do NOT include /api or trailing slash)
# Local Development: http://localhost:5000
# Production: https://api.yourdomain.com or https://yourdomain.com
VITE_SOCKET_URL=http://localhost:5000
